class Updater {
    field int carpetCnt;
    field int playerTurn;
    field GameManager gameManager;

    constructor Updater new(GameManager passin){
        let gameManager = passin;
        do reset();
        return this;
    }

    method void reset(){
        let carpetCnt = 48;
        let playerTurn = 0;
        return;
    }

    method int nextTurn(){
        do gameManager.turnCharacter(playerTurn);
        let carpetCnt = carpetCnt - 1;
        let playerTurn = (playerTurn + 1);
        if(playerTurn = 4){
            let playerTurn = 0;
        }
        //update player info;
        return (~(carpetCnt = 0));
    }
    
}