class Updater {
    
    var int carpetCnt = 48;
    var int playerTurn = 0;

    constructor Updater new(){
        do reset();
        return this;
    }

    method void reset(){
        let carpetCnt = 48;
        let playerTurn = 0;
    }

    method char readInput(){
        var char key;
        while(key = 0){
            let key = Keyboard.keyPressed();
        }
        return key;
    }

    method int NextTurn(){
        GameManager.gameManager.character.turn(playerTurn);
        let carpetCnt = carpetCnt - 1;
        let playerTurn = (playerTurn + 1)%4;
        return (~(carpetCnt = 0));
    }
    
}