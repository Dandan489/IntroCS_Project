class Random{
    /*random generator function*/
    method int rand(int round, int player){
        var int seed;
        var int INTMAX = 32767
        let seed = ((round*7414+player)*8)%6; //this can be change later
        if(seed < 0){
            let seed = INTMAX + seed + 1;
        }
        return seed;
    }
}