class CarpetPlacer {
    field int maxType;
    field GameManager gameManager;

    constructor CarpetPlacer new(GameManager passin){
        let gameManager = passin;
        let maxType = 12;
        return this;
    }

    method void previewCarpet(int type, int x, int y, int player){ //let player preview carpets by showing them on board
        var char key;
        var int exit;
        var int first;

        let exit = 0;
        let first = 1;

        while (~exit){
            let key = KeyboardInput.readInput();
            if(key = 130){ //Left Arrow
                if(~first){
                    do restoreCarpet(type, x, y);
                }
                
                let type = type - 1;
                if(type < 0){
                    let type = maxType - 1;
                }
                let player = placeCarpet(type, x, y, player);
                let first = 0;
            }
            if(key = 132){ //Right Arrow
                if(~first){
                    do restoreCarpet(type, x, y);
                }
                
                let type = type + 1;
                if(type = maxType){
                    let type = 0;
                }
                let player = placeCarpet(type, x, y, player);
                let first = 0;
            }
            if(key = 128){ //Enter
                do setGameBoard();
                let exit = 1;
            }
            do KeyboardInput.waitRelease();
        }
        return;
    }

    method void restoreCarpet(int type, int x, int y){
        var int xcen;
        var int ycen;

        let xcen = (26 * x + 49);
        let ycen = (26 * y + 49);

        do Screen.setColor(false);
        do Screen.drawRectangle(xcen-12, ycen-12, xcen+12, ycen+12);

        //place down the original number at the actual location
        return;
    }

    method void placeCarpet(int type, int x, int y, int player){ //show carpet on board
        var int xcen;
        var int ycen;

        let xcen = (26 * x + 49);
        let ycen = (26 * y + 49);

        do Screen.setColor(false);
        do Screen.drawRectangle(xcen-12, ycen-12, xcen+12, ycen+12);

        //place down number at the actual location
        return;
    }
    
    method void setGameBoard(){
        //set gameboard
        return;
    }
}