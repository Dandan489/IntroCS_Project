class CarpetPlacer {    

    var int maxType = 12;
    var Array2D gameBoard;

    method void reset(){
        let gameBoard = Array2D.new(7,7);
    }

    method char readInput(){
        var char key;
        while(key = 0){
            let key = Keyboard.keyPressed();
        }
        return key;
    }

    method void previewCarpet(int type, int x, int y, int player){ //let player preview carpets by showing them on board
        var char key;
        var int exit = 0;
        while (~exit){
            let key = readInput();
            if(key = 130){ //Left Arrow
                let player = placeCarpet(type, x, y, player);
                let type = type - 1;
                if(type < 0){
                    let type = maxType - 1;
                }
                let player = placeCarpet(type, x, y, player);
            }
            else if(key = 132){ //Right Arrow
                let player = placeCarpet(type, x, y, player);
                let type = type + 1;
                if(type = maxType){
                    let type = 0;
                }
                let player = placeCarpet(type, x, y, player);
            }
            else if(key = 128){ //Enter
                let exit = 1;
            }
        }
        return;
    }

