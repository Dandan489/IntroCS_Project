class CarpetPlacer {
    field GameManager gameManager;

    constructor CarpetPlacer new(GameManager passin){
        let gameManager = passin;
        return this;
    }

    method void previewCarpet(int x, int y, int player){ //let player preview carpets by showing them on board
        var char key;
        var char ban;
        var int exit;
        var int newx;
        var int newy;
        var int put;

        let exit = 0;
        let put = 0;

        while (~exit){
            let key = KeyboardInput.readInput();
            if(key = 130){ //Left Arrow
                let newx = x;
                let newy = y-1;
                let ban = 132;
                let put = 1;
            }
            if(key = 131){ //Up Arrow
                let newx = x-1;
                let newy = y;
                let ban = 133;
                let put = 1;
            }
            if(key = 132){ //Right Arrow
                let newx = x;
                let newy = y+1;
                let ban = 130;
                let put = 1;
            }
            if(key = 133){ //Down Arrow
                let newx = x+1;
                let newy = y;
                let ban = 131;
                let put = 1;
            }

            if(put & (newx < 7) & (newx > -1) & (newy < 7) & (newy > -1)){
                do NumberPrinter.printNumber(newx, newy, player+1);
                do gameManager.setGameBoard(newx, newy, player);
                let exit = 1;
            }
            do Sys.wait(200);
        }

        let exit = 0;
        let put = 0;
        let x = newx;
        let y = newy;
        while (~exit){
            let key = KeyboardInput.readInput();
            if(key = 130){ //Left Arrow
                let newx = x;
                let newy = y-1;
                let put = 1;
            }
            if(key = 131){ //Up Arrow
                let newx = x-1;
                let newy = y;
                let put = 1;
            }
            if(key = 132){ //Right Arrow
                let newx = x;
                let newy = y+1;
                let put = 1;
            }
            if(key = 133){ //Down Arrow
                let newx = x+1;
                let newy = y;
                let put = 1;
            }

            if(put & (newx < 7) & (newx > -1) & (newy < 7) & (newy > -1) & ~(key = ban)){
                do NumberPrinter.printNumber(newx, newy, player+1);
                do gameManager.setGameBoard(newx, newy, player);
                let exit = 1;
            }
            do Sys.wait(200);
        }
        return;
    }
}