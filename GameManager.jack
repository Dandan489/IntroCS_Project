class GameManager {

    static GameManager gameManager = this;
    var CarpetPlacer carpetPlacer;
    var Character character;
    var Updater updater;

    var Array score;
    var Array2D gameBoard;
    
    var int turn = 0;

    constructor GameManager new(){
        do reset();
        return this;
    }

    method void reset(){
        let score = Array.new(4);
        let gameBoard = Array2D.new(7,7);
        let carpetPlacer = CarpetPlacer.new();
        let character = Character.new();
        let updater = Updater.new();

        let carpetCnt = 48;
        let turn = 0;

        var int index = 0;
        while(index!=4){
            let score[index] = 0;
            let index = index + 1;
        }
        return;
    }

    method void addScore(int player, int score){
        let score[player] = score[player] + score;
        return;
    }

    method void startScene(){
        return;
    }

    method void gameScene(){
        return;
    }

    method void endScene(){
        return;
    } 
}